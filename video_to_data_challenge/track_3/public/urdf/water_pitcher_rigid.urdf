<?xml version="1.0"?>
<robot name="track3_water_pitcher">
  <!-- Track 3 supplies no measured physical properties. 0.3 kg is a placeholder mass; COM/inertia are a uniform triangle-surface estimate over the collision mesh. -->
  <mujoco><compiler balanceinertia="true" discardvisual="false"/></mujoco>
  <link name="object">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00334701769196674" ixy="0" ixz="0" iyy="0.00247066783911264" iyz="0" izz="0.00155438810654303"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../mesh/water_pitcher/water_pitcher.glb" scale="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../mesh/water_pitcher/water_pitcher.glb" scale="1 1 1"/></geometry>
    </collision>
  </link>
</robot>
