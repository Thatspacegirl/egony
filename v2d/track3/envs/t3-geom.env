# source me:  source ~/TestingGrounds/egony/v2d/track3/envs/t3-geom.env
# Host venv for stereo depth (FoundationStereo TAO ONNX -> TensorRT 10.7 / onnxruntime-gpu 1.22) and VO (cuVSLAM 17 cu12).
export T3_GEOM=/mnt/secondary/v2d/envs/t3-geom
_SP=$T3_GEOM/lib/python3.12/site-packages
export LD_LIBRARY_PATH=$(ls -d $_SP/nvidia/*/lib $_SP/tensorrt_libs 2>/dev/null | tr '\n' ':')${LD_LIBRARY_PATH}
export PATH=$T3_GEOM/bin:$PATH
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4} MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
